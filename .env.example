# Copy this file to .env and fill in the two values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle, so only the
# anon key belongs here. It is safe to ship: row level security decides what
# it can actually reach. NEVER put the service_role key in this file.
#
# After changing these, restart Expo with a cleared cache:
#   npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
